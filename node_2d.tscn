[sub_resource type="GDScript" id="GDScript_q6r6c"]
script/source = "extends Button

@onready var input_box = $\"../LineEdit\"
@onready var output_box = $\"../RichTextLabel\"

func _pressed():
	var query = input_box.text.strip_edges().to_lower()
	var results = []

	var file_path = \"user://index.txt\"  # Or wherever your .bat file saves it
	if FileAccess.file_exists(file_path):
		var file = FileAccess.open(file_path, FileAccess.READ)
		while not file.eof_reached():
			var line = file.get_line()
			if query in line.to_lower():
				results.append(line)
		file.close()

		if results.size() > 0:
			output_box.text = \"Found:\\n\" + \"\\n\".join(results)
		else:
			output_box.text = \"No matches found.\"
	else:
		output_box.text = \"Index file not found. Please run indexing first.\"
"

[sub_resource type="GDScript" id="GDScript_kdubu"]

